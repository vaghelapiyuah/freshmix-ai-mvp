# Copy to .env. The MVP runs fully offline with no keys (mock catalog +
# rule-based agent). Add a key to enable the Claude agent path.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Music source: "itunes" (real songs via Apple, no key — default) or "mock" (offline catalog).
MUSIC_SOURCE=itunes
