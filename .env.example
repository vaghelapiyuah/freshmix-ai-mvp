# Copy to .env. The MVP runs fully offline with no keys (mock catalog +
# rule-based agent). Add a key to enable the Claude agent path.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Music source: "spotify" (real Spotify API), "itunes" (real, no key — default), or "mock".
MUSIC_SOURCE=itunes

# Spotify Web API (only needed when MUSIC_SOURCE=spotify). Free app at developer.spotify.com.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
